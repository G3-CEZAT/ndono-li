# URL du backend NestJS (ndono-li/backend-api), PAS du ai-service (:8000).
# Sur un appareil physique testé via Expo Go, remplacer localhost par l'IP locale du PC
# (ex: http://192.168.1.42:3000) - localhost sur le téléphone pointerait vers le téléphone lui-même.
EXPO_PUBLIC_API_URL=http://localhost:3000
